# 正则速查表
translationmod.regex_gui.cheatsheet.dot=. - 匹配任意字符
translationmod.regex_gui.cheatsheet.dot.desc1=匹配单个任意字符
translationmod.regex_gui.cheatsheet.dot.desc2=例外：换行符（\\n）
translationmod.regex_gui.cheatsheet.dot.desc3=聊天消息无换行符，无需考虑

translationmod.regex_gui.cheatsheet.word=\\w - 匹配单词字符
translationmod.regex_gui.cheatsheet.word.desc1=匹配字母、数字、下划线
translationmod.regex_gui.cheatsheet.word.desc2=适合检测Minecraft用户名

translationmod.regex_gui.cheatsheet.digit=\\d - 匹配数字
translationmod.regex_gui.cheatsheet.digit.desc1=匹配0-9的数字

translationmod.regex_gui.cheatsheet.range=[a-g] - 匹配范围内字符
translationmod.regex_gui.cheatsheet.range.desc1=匹配指定区间的任意字符
translationmod.regex_gui.cheatsheet.range.desc2=示例：[a-g]

translationmod.regex_gui.cheatsheet.star=* - 匹配0次或多次
translationmod.regex_gui.cheatsheet.star.desc1=匹配前一个字符0次及以上
translationmod.regex_gui.cheatsheet.star.desc2=示例：N\\w*

translationmod.regex_gui.cheatsheet.plus=+ - 匹配1次或多次
translationmod.regex_gui.cheatsheet.plus.desc1=匹配前一个字符1次及以上
translationmod.regex_gui.cheatsheet.plus.desc2=示例：N\\w+

translationmod.regex_gui.cheatsheet.optional=? - 可选匹配
translationmod.regex_gui.cheatsheet.optional.desc1=匹配前一个内容0次或1次
translationmod.regex_gui.cheatsheet.optional.desc2=示例：(VIP )?\\w+

translationmod.regex_gui.cheatsheet.brace={2,} - 匹配n次及以上
translationmod.regex_gui.cheatsheet.brace.desc1=匹配至少n次
translationmod.regex_gui.cheatsheet.brace.desc2=x到y次：逗号后加数字
translationmod.regex_gui.cheatsheet.brace.desc3=精确n次：省略逗号
translationmod.regex_gui.cheatsheet.brace.desc4=示例：Level \\d{1,3}

translationmod.regex_gui.cheatsheet.either=| - 或匹配
translationmod.regex_gui.cheatsheet.either.desc1=匹配其中一个，不同时匹配
translationmod.regex_gui.cheatsheet.either.desc2=示例：(Dead)|(Alive) (\\w+)

translationmod.regex_gui.cheatsheet.group=() - 分组
translationmod.regex_gui.cheatsheet.group.desc1=类似数学中的括号
translationmod.regex_gui.cheatsheet.group.desc2=可用于捕获内容
translationmod.regex_gui.cheatsheet.group.desc3=指定分组编号后，
translationmod.regex_gui.cheatsheet.group.desc4=模组可识别玩家用户名所在分组

translationmod.regex_gui.cheatsheet.escape=\\\\ - 转义字符
translationmod.regex_gui.cheatsheet.escape.desc1=匹配特殊字符需加反斜杠
translationmod.regex_gui.cheatsheet.escape.desc2=进行转义
translationmod.regex_gui.cheatsheet.escape.correct=正确写法：
translationmod.regex_gui.cheatsheet.escape.wrong=错误写法：

