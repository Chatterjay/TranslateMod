translationmod.regex_gui.chat.regex_applied=正则表达式列表已应用

translationmod.regex_gui.cheatsheet.dot=. - 匹配任意字符
translationmod.regex_gui.cheatsheet.dot.desc1=匹配任意单个字符
translationmod.regex_gui.cheatsheet.dot.desc2=唯一例外是换行符（\\n）
translationmod.regex_gui.cheatsheet.dot.desc3=聊天消息中无换行符，因此无需考虑

translationmod.regex_gui.cheatsheet.word=\\w - 匹配单词字符
translationmod.regex_gui.cheatsheet.word.desc1=匹配所有字母（大小写）、数字和下划线
translationmod.regex_gui.cheatsheet.word.desc2=Minecraft用户名由单词字符组成，适合用于检测玩家名称

translationmod.regex_gui.cheatsheet.digit=\\d - 匹配数字
translationmod.regex_gui.cheatsheet.digit.desc1=匹配所有0-9的数字

translationmod.regex_gui.cheatsheet.range=[a-g] - 匹配范围内的字符
translationmod.regex_gui.cheatsheet.range.desc1=匹配指定范围内的任意字符
translationmod.regex_gui.cheatsheet.range.desc2=示例：[a-g]

translationmod.regex_gui.cheatsheet.star=* - 匹配0次或多次
translationmod.regex_gui.cheatsheet.star.desc1=匹配其前面的字符类0次或多次
translationmod.regex_gui.cheatsheet.star.desc2=示例：N\\w*

translationmod.regex_gui.cheatsheet.plus=+ - 匹配1次或多次
translationmod.regex_gui.cheatsheet.plus.desc1=匹配其前面的字符/分组1次或多次
translationmod.regex_gui.cheatsheet.plus.desc2=示例：N\\w+

translationmod.regex_gui.cheatsheet.optional=? - 可选匹配
translationmod.regex_gui.cheatsheet.optional.desc1=顾名思义，匹配其前面的内容0次或1次
translationmod.regex_gui.cheatsheet.optional.desc2=示例：(VIP )?\\w+

translationmod.regex_gui.cheatsheet.brace={2,} - 匹配n次或更多
translationmod.regex_gui.cheatsheet.brace.desc1=匹配指定分组/字符至少n次
translationmod.regex_gui.cheatsheet.brace.desc2=如需匹配x到y次，可在逗号后添加数字
translationmod.regex_gui.cheatsheet.brace.desc3=如需精确匹配n次，可省略逗号
translationmod.regex_gui.cheatsheet.brace.desc4=示例：Level \\d{1,3}

translationmod.regex_gui.cheatsheet.either=| - 或匹配
translationmod.regex_gui.cheatsheet.either.desc1=必须匹配其中一个，但不能同时匹配
translationmod.regex_gui.cheatsheet.either.desc2=示例：(Dead)|(Alive) (\\w+)

translationmod.regex_gui.cheatsheet.group=() - 分组
translationmod.regex_gui.cheatsheet.group.desc1=可以将分组理解为数学中的括号
translationmod.regex_gui.cheatsheet.group.desc2=分组还有第二个功能：捕获分组
translationmod.regex_gui.cheatsheet.group.desc3=通过在下方指定分组编号，模组可以识别哪个分组
translationmod.regex_gui.cheatsheet.group.desc4= 包含玩家的用户名

translationmod.regex_gui.cheatsheet.escape=\\\\ - 转义字符
translationmod.regex_gui.cheatsheet.escape.desc1=如需匹配本列表中的特殊字符，
translationmod.regex_gui.cheatsheet.escape.desc2= 需要添加额外的反斜杠进行转义
translationmod.regex_gui.cheatsheet.escape.correct=正确写法：
translationmod.regex_gui.cheatsheet.escape.wrong=错误写法：

